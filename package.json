    "puppeteer": "^24.41.0",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.4",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
